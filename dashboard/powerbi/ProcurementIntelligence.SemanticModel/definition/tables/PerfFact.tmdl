table PerfFact
	lineageTag: 6f3ddc99-4308-5cca-8fa4-a2a8cc9907c9

	measure 'Perf Noncancelled Orders' = CALCULATE(COUNTROWS(PerfFact),PerfFact[valid_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: 86703cd2-05c4-40cc-9fa2-fd3ab6636afd

	measure 'Perf Noncancelled Amount' = CALCULATE(SUM(PerfFact[amount]),PerfFact[valid_order]=TRUE())
		formatString: #,0.00
		displayFolder: Audited metrics
		lineageTag: 0c9b7eeb-a2b1-4609-bf71-4247eed1daa4

	measure 'Perf Cancelled Amount' = CALCULATE(SUM(PerfFact[amount]),PerfFact[valid_order]=FALSE())
		formatString: #,0.00
		displayFolder: Audited metrics
		lineageTag: b40d9c38-3627-4f60-9809-b3a26a8a7b39

	measure 'Perf Delivered Amount' = CALCULATE(SUM(PerfFact[amount]),PerfFact[delivered_order]=TRUE())
		formatString: #,0.00
		displayFolder: Audited metrics
		lineageTag: 39a574ff-7899-4d19-a59d-4539c7b59660

	measure 'Perf Nominal Price Difference' = CALCULATE(SUM(PerfFact[baseline_amount])-SUM(PerfFact[amount]),PerfFact[valid_order]=TRUE())
		formatString: #,0.00
		displayFolder: Audited metrics
		lineageTag: e13cd733-e7aa-453f-89a0-f6dee82f947c

	measure 'Perf Delivered Orders' = CALCULATE(COUNTROWS(PerfFact),PerfFact[delivered_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: 1693e2b5-c739-4977-be49-558c02d0e670

	measure 'Perf Delivery Days' = CALCULATE(AVERAGE(PerfFact[delivery_days]),PerfFact[valid_order]=TRUE())
		formatString: 0.00
		displayFolder: Audited metrics
		lineageTag: 1ecdd8ed-cf2f-412a-9fe1-60c9c93e9be0

	measure 'Perf Delivery Samples' = CALCULATE(COUNT(PerfFact[delivery_days]),PerfFact[valid_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: b3481dc6-5c32-4882-bfb9-460ea59dd72e

	measure 'Perf Delivery Coverage' = DIVIDE([Perf Delivery Samples],[Perf Delivered Orders])
		formatString: 0.0%
		displayFolder: Audited metrics
		lineageTag: c80343e6-8a90-4adf-ba5b-b7b03f699c83

	measure 'Perf Recorded Compliance Rate' = CALCULATE(AVERAGE(PerfFact[compliant]),PerfFact[valid_order]=TRUE())
		formatString: 0.0%
		displayFolder: Audited metrics
		lineageTag: 4f5b6df0-df04-4c3d-a192-74a28edef220

	measure 'Perf Compliance Samples' = CALCULATE(COUNT(PerfFact[compliant]),PerfFact[valid_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: 6808dd67-e103-4225-b55f-1c67eb47e46d

	measure 'Perf Quality Samples' = CALCULATE(COUNT(PerfFact[observed_defective_units]),PerfFact[valid_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: 4fc3538c-e791-4255-9ff5-37604521489e

	measure 'Perf Quality Record Coverage' = DIVIDE([Perf Quality Samples],[Perf Delivered Orders])
		formatString: 0.0%
		displayFolder: Audited metrics
		lineageTag: 7cb6c797-dce8-44aa-b01e-99ec1da2a1f1

	measure 'Perf Observed Defects' = CALCULATE(SUM(PerfFact[observed_defective_units]),PerfFact[valid_order]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: 3ef6caac-6444-4309-854c-8345841a0a69

