	partition MarketQuotes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectRoot & "\dashboard\powerbi\input\MarketQuotes.csv"), [Delimiter=",", Columns=40, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
