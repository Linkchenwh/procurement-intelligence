table MarketQuotes
	lineageTag: 042acd4a-1bef-5c86-8f19-0fe68a136ec2

	measure 'Market Comparable Observations' = CALCULATE(COUNTROWS(MarketQuotes),MarketQuotes[spec_comparable]=TRUE())
		formatString: #,0
		displayFolder: Audited metrics
		lineageTag: c842b29f-e660-44f6-b82b-d561b385895f

	measure 'Market Minimum Listed Price SameCurrency' = IF(HASONEVALUE(MarketQuotes[currency]),CALCULATE(MIN(MarketQuotes[price_per_500]),MarketQuotes[spec_comparable]=TRUE()))
		formatString: 0.00
		displayFolder: Audited metrics
		lineageTag: 9653855d-d6d5-4baf-b629-cfb1d47efb59

	measure 'Market Maximum Listed Price SameCurrency' = IF(HASONEVALUE(MarketQuotes[currency]),CALCULATE(MAX(MarketQuotes[price_per_500]),MarketQuotes[spec_comparable]=TRUE()))
		formatString: 0.00
		displayFolder: Audited metrics
		lineageTag: 989ba057-1576-444f-83e8-a8bf6b039431

	measure 'Market Comparable Listed Price' = IF(HASONEVALUE(MarketQuotes[currency]) && SELECTEDVALUE(MarketQuotes[spec_comparable])=TRUE(),MAX(MarketQuotes[price_per_500]))
		formatString: 0.00
		displayFolder: Audited metrics
		lineageTag: 7ee8a5ad-8e96-410f-955a-d646b83ef67a

