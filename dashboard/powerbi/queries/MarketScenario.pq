let
    Source = Csv.Document(File.Contents(ProjectRoot & "\dashboard\powerbi\input\MarketScenario.csv"), [Delimiter=",", Columns=50, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
    Typed = Table.TransformColumnTypes(Blanks, {{"quote_id", type text}, {"brand", type text}, {"product_name", type text}, {"sku", type text}, {"manufacturer", type text}, {"seller", type text}, {"contract_supplier", type text}, {"channel", type text}, {"paper_size", type text}, {"gsm", type number}, {"sheets_per_ream", Int64.Type}, {"reams_per_box", Int64.Type}, {"price", Currency.Type}, {"currency", type text}, {"quote_unit", type text}, {"min_order_units", Int64.Type}, {"max_order_units", Int64.Type}, {"tax_status", type text}, {"shipping_cost", Currency.Type}, {"shipping_terms", type text}, {"tax_terms", type text}, {"region", type text}, {"lead_time_days", type number}, {"collected_at", type text}, {"url", type text}, {"attributes", type text}, {"data_status", type text}, {"notes", type text}, {"evidence_file", type text}, {"evidence_sha256", type text}, {"source_domain", type text}, {"packaging_conflict", type logical}, {"review_note", type text}, {"reams_per_unit", type number}, {"price_per_500", Currency.Type}, {"spec_comparable", type logical}, {"quote_age_days", Int64.Type}, {"fresh_observation", type logical}, {"source_link_present", type logical}, {"evidence_note", type text}, {"requested_reams", Int64.Type}, {"purchase_units", Int64.Type}, {"supplied_reams", type number}, {"goods_reference_cost", Currency.Type}, {"total_cost", Currency.Type}, {"budget_difference", Currency.Type}, {"scenario_comparable", type logical}, {"limitations", type text}, {"calculation_basis", type text}, {"rank", type number}}, "en-US")
in
    Typed
